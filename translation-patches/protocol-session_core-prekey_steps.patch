+// SPDX-License-Identifier: AGPL-3.0-only
+//
+
+//! The synchronous steps of `process_prekey` and `process_prekey_bundle`.
+//!
+//! Both callers are `async` and call the application's stores, which the extraction cannot
+//! translate. Each function here is one stretch of their code between two store calls, moved
+//! out unchanged. The callers keep the store calls and run these steps in the original order.
+
+use std::time::SystemTime;
+
+use rand::{CryptoRng, Rng};
+
+use crate::protocol::CIPHERTEXT_MESSAGE_PRE_KYBER_VERSION;
+use crate::ratchet::{AliceSignalProtocolParameters, BobSignalProtocolParameters};
+use crate::state::SessionState;
+use crate::{
+    CiphertextMessageType, IdentityKey, IdentityKeyPair, KeyPair, KyberPreKeyId, PreKeyBundle,
+    PreKeyId, PreKeySignalMessage, ProtocolAddress, PublicKey, Result, SessionRecord,
+    SignalProtocolError, kem, ratchet,
+};
+
+/// What both callers do with the store's answer to `is_trusted_identity`.
+pub(crate) fn require_trusted_identity(
+    is_trusted: bool,
+    remote_address: &ProtocolAddress,
+) -> Result<()> {
+    if !is_trusted {
+        return Err(SignalProtocolError::UntrustedIdentity(
+            remote_address.clone(),
+        ));
+    }
+    Ok(())
+}
+
+/// The two signature checks of `process_prekey_bundle`.
+pub(crate) fn verify_bundle_signatures(
+    their_identity_key: &IdentityKey,
+    bundle: &PreKeyBundle,
+) -> Result<()> {
+    if !their_identity_key.public_key().verify_signature(
+        &bundle.signed_pre_key_public()?.serialize(),
+        bundle.signed_pre_key_signature()?,
+    ) {
+        return Err(SignalProtocolError::SignatureValidationFailed);
+    }
+
+    if !their_identity_key.public_key().verify_signature(
+        &bundle.kyber_pre_key_public()?.serialize(),
+        bundle.kyber_pre_key_signature()?,
+    ) {
+        return Err(SignalProtocolError::SignatureValidationFailed);
+    }
+    Ok(())
+}
+
+/// The initiator's choices in `process_prekey_bundle` before it asks the store for its own
+/// identity key pair: its ephemeral key pair, and the bundle's signed prekey, Kyber prekey and
+/// one-time prekey ID.
+pub(crate) fn choose_initiator_keys<R: Rng + CryptoRng>(
+    bundle: &PreKeyBundle,
+    csprng: &mut R,
+) -> Result<(KeyPair, PublicKey, kem::PublicKey, Option<PreKeyId>)> {
+    let our_base_key_pair = KeyPair::generate(csprng);
+    let their_signed_prekey = bundle.signed_pre_key_public()?;
+    let their_kyber_prekey = bundle.kyber_pre_key_public()?;
+
+    let their_one_time_prekey_id = bundle.pre_key_id()?;
+    Ok((
+        our_base_key_pair,
+        their_signed_prekey,
+        their_kyber_prekey.clone(),
+        their_one_time_prekey_id,
+    ))
+}
+
+fn log_unacknowledged_pre_key_message(
+    remote_address: &ProtocolAddress,
+    their_one_time_prekey_id: Option<PreKeyId>,
+) {
+    log::info!(
+        "set_unacknowledged_pre_key_message for: {} with preKeyId: {}",
+        remote_address,
+        their_one_time_prekey_id.map_or_else(|| "<none>".to_string(), |id| id.to_string())
+    );
+}
+
+/// The initiator's PQXDH and session set-up in `process_prekey_bundle`, up to and including the
+/// pending prekey IDs that its first message carries.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn start_initiator_session<R: Rng + CryptoRng>(
+    local_address: &ProtocolAddress,
+    remote_address: &ProtocolAddress,
+    their_identity_key: &IdentityKey,
+    our_identity_key_pair: IdentityKeyPair,
+    our_base_key_pair: KeyPair,
+    their_signed_prekey: PublicKey,
+    their_kyber_prekey: kem::PublicKey,
+    their_one_time_prekey_id: Option<PreKeyId>,
+    bundle: &PreKeyBundle,
+    now: SystemTime,
+    csprng: &mut R,
+) -> Result<SessionState> {
+    let mut parameters = AliceSignalProtocolParameters::new(
+        our_identity_key_pair,
+        our_base_key_pair,
+        *their_identity_key,
+        their_signed_prekey,
+        their_signed_prekey,
+        their_kyber_prekey,
+        our_identity_key_pair.identity_key().is_same_account(
+            local_address,
+            their_identity_key,
+            remote_address,
+        ),
+    );
+    if let Some(key) = bundle.pre_key_public()? {
+        parameters.set_their_one_time_pre_key(key);
+    }
+
+    let mut session = ratchet::initialize_alice_session(&parameters, csprng)?;
+
+    log_unacknowledged_pre_key_message(remote_address, their_one_time_prekey_id);
+
+    session.set_unacknowledged_pre_key_message(
+        their_one_time_prekey_id,
+        bundle.signed_pre_key_id()?,
+        &our_base_key_pair.public_key,
+        now,
+    );
+    session.set_unacknowledged_kyber_pre_key_id(bundle.kyber_pre_key_id()?);
+    Ok(session)
+}
+
+/// The responder's lookup of an existing session with the same version and base key. Returns
+/// `true` when one exists and the message's identity key matches it.
+pub(crate) fn reuse_matching_session(
+    message: &PreKeySignalMessage,
+    session_record: &mut SessionRecord,
+) -> Result<bool> {
+    if session_record.promote_matching_session(
+        message.message_version() as u32,
+        &message.base_key().serialize(),
+    )? {
+        // We've already set up a session for this message, we can exit early as long as the
+        // identity key hasn't changed. (Note that this is a constant-time comparison as long as the
+        // keys have the same type: see PublicKey's PartialEq.)
+        if !session_record
+            .session_state()
+            .expect("just promoted a session")
+            .remote_identity_key()?
+            .is_some_and(|stored| *message.identity_key() == stored)
+        {
+            // We return this as InvalidMessage rather than any other error because there's no
+            // expected recovery; barring data corruption, the peer has just decided to send us the
+            // wrong identity key for no apparent reason. (Of course, it's possible it's the local
+            // state that's wrong, but that's true for the eventual MAC check as well.)
+            return Err(SignalProtocolError::InvalidMessage(
+                CiphertextMessageType::PreKey,
+                "remote identity key not consistent with previously-established session".to_owned(),
+            ));
+        }
+        return Ok(true);
+    }
+    Ok(false)
+}
+
+/// The responder's refusal of the pre-Kyber message version.
+pub(crate) fn reject_pre_kyber_version(message: &PreKeySignalMessage) -> Result<()> {
+    // Check this *after* looking for an existing session; since we have already performed XDH for
+    // such a session, enforcing PQXDH *now* would be silly.
+    if message.message_version() == CIPHERTEXT_MESSAGE_PRE_KYBER_VERSION {
+        // Specifically return InvalidMessage here rather than LegacyCiphertextVersion; the Signal
+        // Android app treats LegacyCiphertextVersion as a structural issue rather than a retryable
+        // one, and won't cause the sender and receiver to move over to a PQXDH session.
+        return Err(SignalProtocolError::InvalidMessage(
+            CiphertextMessageType::PreKey,
+            "X3DH no longer supported".to_owned(),
+        ));
+    }
+    Ok(())
+}
+
+/// The Kyber prekey ID that the message must name.
+pub(crate) fn required_kyber_pre_key_id(message: &PreKeySignalMessage) -> Result<KyberPreKeyId> {
+    if let Some(kyber_pre_key_id) = message.kyber_pre_key_id() {
+        Ok(kyber_pre_key_id)
+    } else {
+        Err(SignalProtocolError::InvalidMessage(
+            CiphertextMessageType::PreKey,
+            "missing pq pre-key ID".to_owned(),
+        ))
+    }
+}
+
+/// The Kyber ciphertext that the message must carry.
+pub(crate) fn required_kyber_ciphertext(
+    message: &PreKeySignalMessage,
+) -> Result<&kem::SerializedCiphertext> {
+    let kyber_ciphertext =
+        message
+            .kyber_ciphertext()
+            .ok_or(SignalProtocolError::InvalidMessage(
+                CiphertextMessageType::PreKey,
+                "missing pq ciphertext".to_owned(),
+            ))?;
+    Ok(kyber_ciphertext)
+}
+
+/// The responder's PQXDH and session set-up in `process_prekey_impl`, with the keys that the
+/// stores returned. `our_one_time_pre_key_pair` is `None` when the message names no one-time
+/// prekey.
+pub(crate) fn start_responder_session(
+    message: &PreKeySignalMessage,
+    remote_address: &ProtocolAddress,
+    local_address: &ProtocolAddress,
+    our_identity_key_pair: IdentityKeyPair,
+    our_signed_pre_key_pair: KeyPair,
+    our_one_time_pre_key_pair: Option<KeyPair>,
+    our_kyber_pre_key_pair: kem::KeyPair,
+    kyber_ciphertext: &kem::SerializedCiphertext,
+) -> Result<SessionState> {
+    let parameters = BobSignalProtocolParameters::new(
+        our_identity_key_pair,
+        our_signed_pre_key_pair,
+        our_one_time_pre_key_pair,
+        our_kyber_pre_key_pair,
+        *message.identity_key(),
+        *message.base_key(),
+        kyber_ciphertext.clone(),
+        our_identity_key_pair.identity_key().is_same_account(
+            local_address,
+            message.identity_key(),
+            remote_address,
+        ),
+    );
+
+    // The recipient's initial ratchet key is the signed pre-key.
+    ratchet::initialize_bob_session(&parameters, &our_signed_pre_key_pair)
+}
