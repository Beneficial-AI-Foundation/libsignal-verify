         csprng: &mut R,
     ) -> Result<ChainKey> {
-        let sender_private_key = self
-            .sender_chain
-            .as_ref()
-            .ok_or(InvalidSessionError("missing sender chain"))?
-            .ratchet_key
-            .private_key;
+        let Some(sender_chain) = self.sender_chain.as_ref() else {
