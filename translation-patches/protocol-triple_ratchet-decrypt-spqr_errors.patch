Translation patch: libsignal_protocol::triple_ratchet::TripleRatchet::decrypt (SPQR errors)

Change: `match e { spqr::Error::StateDecode => …, _ => … }` becomes `if is_state_decode(&e) { … } else { … }` with the same two results. `is_state_decode` is a new function.
Why: `spqr::Error` has an `InvalidParams(&'static str)` variant, and matching it hits the same static-borrow defect (a crash in Aeneas's translation pass). `is_state_decode` is opaque in the extraction (`aeneas-config.protocol.yml`).
Behaviour: identical.
Applies after: protocol-triple_ratchet-address_pair.patch (their lines are this patch's context).

diff --git a/rust/protocol/src/triple_ratchet.rs b/rust/protocol/src/triple_ratchet.rs
--- a/rust/protocol/src/triple_ratchet.rs
+++ b/rust/protocol/src/triple_ratchet.rs
@@ -53,6 +53,12 @@ fn decrypt_failure_message(error: signal_crypto::DecryptionError) -> String {
     }
 }
 
+// Test the variant in a helper: matching `spqr::Error` expands its
+// `InvalidParams(&'static str)` variant, which Aeneas cannot translate.
+fn is_state_decode(error: &spqr::Error) -> bool {
+    matches!(error, spqr::Error::StateDecode)
+}
+
 /// Sender-side Triple Ratchet session.
 ///
 /// This is intentionally narrower than [`TripleRatchet`]: encrypt only
@@ -268,15 +274,18 @@ impl TripleRatchet {
         let spqr::Recv {
             state: new_pqr_state,
             key: pqr_key,
-        } = spqr::recv(&self.pqr_state, ciphertext.pq_ratchet()).map_err(|e| match e {
-            spqr::Error::StateDecode => SignalProtocolError::InvalidState(
-                "decrypt",
-                format!("post-quantum ratchet error: {e}"),
-            ),
-            _ => SignalProtocolError::InvalidMessage(
-                original_message_type,
-                format!("post-quantum ratchet error: {e}"),
-            ),
+        } = spqr::recv(&self.pqr_state, ciphertext.pq_ratchet()).map_err(|e| {
+            if is_state_decode(&e) {
+                SignalProtocolError::InvalidState(
+                    "decrypt",
+                    format!("post-quantum ratchet error: {e}"),
+                )
+            } else {
+                SignalProtocolError::InvalidMessage(
+                    original_message_type,
+                    format!("post-quantum ratchet error: {e}"),
+                )
+            }
         })?;
 
         // Derive final message keys by mixing DR chain key with SPQR key
